# Custom commands run after the standard updates.
# One command per line. Blank lines and lines starting with # are ignored.

# Update pi and all installed extensions.
# The npm global package step above already refreshes the pi CLI itself, so this
# primarily picks up extension updates.
pi update --extensions

# Update pnpm itself.
pnpm self-update

