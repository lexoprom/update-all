#!/bin/sh
set -eu

root=$(CDPATH='' cd "$(dirname "$0")/.." && pwd)

init() {
  mkdir -p "$root/.de"
  [ -e "$root/.de/decide-to-execute.md" ] ||
    printf '%s\n' '<!-- DECIDE writes its latest message here. -->' >"$root/.de/decide-to-execute.md"
  [ -e "$root/.de/execute-to-decide.md" ] ||
    printf '%s\n' '<!-- EXECUTE writes its latest message here. -->' >"$root/.de/execute-to-decide.md"
  if [ ! -e "$root/.gitignore" ]; then
    printf '%s\n' '.de/' >"$root/.gitignore"
  elif ! grep -qxF '.de/' "$root/.gitignore"; then
    printf '\n%s\n' '.de/' >>"$root/.gitignore"
  fi
  doctor
}

check_status() {
  file=$1
  allowed=$2
  placeholder=$3
  status=$(sed -n '1p' "$file")
  [ "$status" = "$placeholder" ] || printf '%s\n' "$allowed" | grep -qxF "$status"
}

doctor() {
  failures=0

  for file in AGENTS.md DECIDE-EXECUTE.md .gitignore \
    .de/decide-to-execute.md .de/execute-to-decide.md scripts/de-route; do
    if [ -f "$root/$file" ]; then
      printf 'ok: %s\n' "$file"
    else
      printf 'missing: %s\n' "$file" >&2
      failures=$((failures + 1))
    fi
  done

  if git -C "$root" check-ignore -q .de/decide-to-execute.md; then
    printf '%s\n' 'ok: .de is ignored'
  else
    printf '%s\n' 'invalid: .de is not ignored' >&2
    failures=$((failures + 1))
  fi

  tracked=0
  for file in .de/decide-to-execute.md .de/execute-to-decide.md; do
    if git -C "$root" ls-files --error-unmatch -- "$file" >/dev/null 2>&1; then
      printf 'invalid: %s is tracked by Git\n' "$file" >&2
      tracked=1
      failures=$((failures + 1))
    fi
  done
  if [ "$tracked" -eq 0 ]; then
    printf '%s\n' 'ok: protocol files are untracked'
  fi

  if [ -f "$root/.de/decide-to-execute.md" ] &&
    check_status "$root/.de/decide-to-execute.md" \
      '# Plan
# Approved
# Revise
# Reject' \
      '<!-- DECIDE writes its latest message here. -->'; then
    printf '%s\n' 'ok: DECIDE status'
  else
    printf '%s\n' 'invalid: DECIDE status heading' >&2
    failures=$((failures + 1))
  fi

  if [ -f "$root/.de/execute-to-decide.md" ] &&
    check_status "$root/.de/execute-to-decide.md" \
      '# Done
# Needs decision
# Blocked' \
      '<!-- EXECUTE writes its latest message here. -->'; then
    printf '%s\n' 'ok: EXECUTE status'
  else
    printf '%s\n' 'invalid: EXECUTE status heading' >&2
    failures=$((failures + 1))
  fi

  [ "$failures" -eq 0 ] || {
    printf 'de-protocol: %s problem(s)\n' "$failures" >&2
    return 1
  }
  printf '%s\n' 'de-protocol: healthy'
}

install_agents() {
  target=$1
  section=$(sed -n '/^# DECIDE \/ EXECUTE Instructions/,$p' "$root/AGENTS.md")
  if [ ! -f "$target/AGENTS.md" ]; then
    printf '%s\n' "$section" >"$target/AGENTS.md"
    printf '%s\n' 'de-protocol install: created AGENTS.md'
    return
  fi
  if grep -q '^# DECIDE / EXECUTE Instructions' "$target/AGENTS.md"; then
    printf '%s\n' 'de-protocol install: AGENTS.md already has DECIDE/EXECUTE section'
    return
  fi
  printf '\n%s\n' "$section" >>"$target/AGENTS.md"
  printf '%s\n' 'de-protocol install: appended DECIDE/EXECUTE section to AGENTS.md'
}

update_cmd() {
  target=${1:-.}
  case "$target" in
    /*) : ;;
    *) target=$(CDPATH='' cd -- "$target" && pwd) ;;
  esac
  if ! toplevel=$(git -C "$target" rev-parse --show-toplevel 2>/dev/null); then
    printf 'de-protocol update: not inside a Git repository: %s\n' "$target" >&2
    return 1
  fi
  target=$toplevel

  markers=$(grep -c '^# DECIDE / EXECUTE Instructions$' "$target/AGENTS.md" 2>/dev/null || true)
  if [ "$markers" -ne 1 ]; then
    printf 'de-protocol update: AGENTS.md must contain exactly one DECIDE/EXECUTE marker\n' >&2
    return 1
  fi

  if [ "$root" = "$target" ]; then
    printf '%s\n' "de-protocol update: already current: $target"
  else
    tmp=$(mktemp "$target/.de-protocol-agents.XXXXXX") || return 1
    if ! sed '/^# DECIDE \/ EXECUTE Instructions$/,$d' "$target/AGENTS.md" >"$tmp" ||
      ! sed -n '/^# DECIDE \/ EXECUTE Instructions$/,$p' "$root/AGENTS.md" >>"$tmp" ||
      ! mv "$tmp" "$target/AGENTS.md"; then
      rm -f "$tmp"
      return 1
    fi
    mkdir -p "$target/scripts"
    cp "$root/scripts/de-protocol" "$target/scripts/de-protocol"
    chmod +x "$target/scripts/de-protocol"
    cp "$root/scripts/de-route" "$target/scripts/de-route"
    chmod +x "$target/scripts/de-route"
    cp "$root/DECIDE-EXECUTE.md" "$target/DECIDE-EXECUTE.md"
    printf '%s\n' "de-protocol update: updated $target"
  fi

  "$target/scripts/de-protocol" init
}

install_cmd() {
  target=${1:-.}
  case "$target" in
    /*) : ;;
    *) target=$(CDPATH='' cd -- "$target" && pwd) ;;
  esac
  if ! toplevel=$(git -C "$target" rev-parse --show-toplevel 2>/dev/null); then
    printf 'de-protocol install: not inside a Git repository: %s\n' "$target" >&2
    return 1
  fi
  target=$toplevel

  conflicts=
  for f in scripts/de-protocol scripts/de-route DECIDE-EXECUTE.md; do
    if [ -f "$target/$f" ] && ! cmp -s "$root/$f" "$target/$f"; then
      conflicts="$conflicts $f"
    fi
  done
  if [ -n "$conflicts" ]; then
    printf 'de-protocol install: refusing to overwrite differing file(s):%s\n' "$conflicts" >&2
    printf 'de-protocol install: no files written\n' >&2
    return 1
  fi

  if [ "$root" != "$target" ]; then
    mkdir -p "$target/scripts"
    cp "$root/scripts/de-protocol" "$target/scripts/de-protocol"
    chmod +x "$target/scripts/de-protocol"
    cp "$root/scripts/de-route" "$target/scripts/de-route"
    chmod +x "$target/scripts/de-route"
    cp "$root/DECIDE-EXECUTE.md" "$target/DECIDE-EXECUTE.md"
  fi

  install_agents "$target"

  printf '%s\n' "de-protocol install: installed into $target"
  "$target/scripts/de-protocol" init
}

case "${1:-doctor}" in
  init) init ;;
  install) shift; install_cmd "$@" ;;
  update) shift; update_cmd "$@" ;;
  doctor) doctor ;;
  *)
    printf '%s\n' 'usage: de-protocol [init|install [target-directory]|update [target-directory]|doctor]' >&2
    exit 2
    ;;
esac
