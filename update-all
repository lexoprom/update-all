#!/usr/bin/env bash

find_modern_bash() {
    local candidate
    local -a candidates=()

    if [[ -n "${HOMEBREW_PREFIX:-}" ]]; then
        candidates+=("$HOMEBREW_PREFIX/bin/bash")
    fi

    candidates+=(
        /opt/homebrew/bin/bash
        /usr/local/bin/bash
    )

    for candidate in "${candidates[@]}"; do
        [[ -x "$candidate" ]] || continue
        "$candidate" -c 'exit $(( BASH_VERSINFO[0] >= 4 ? 0 : 1 ))' >/dev/null 2>&1 || continue
        printf '%s\n' "$candidate"
        return 0
    done

    return 1
}

if (( ${BASH_VERSINFO[0]:-0} < 4 )); then
    if MODERN_BASH="$(find_modern_bash)"; then
        exec "$MODERN_BASH" "$0" "$@"
    fi

    cat >&2 <<'EOF'
update-all requires Bash 4 or newer.
macOS ships Bash 3.2 at /bin/bash, which cannot run this script.
Install a newer Bash, for example:
  brew install bash
Then run update-all again.
EOF
    exit 1
fi

# Simplified Universal System & Tool Updater - macOS Bash Version (Final Robust)
set -euo pipefail

# Configuration
DRY_RUN=false
VERBOSE=false
FORCE_RUN=false
SCRIPT_NAME="$(basename "$0")"
LOCK_FILE="/tmp/.${SCRIPT_NAME}_lock"
LOCK_ACQUIRED=false
REPORT_DIR=""
SKIP_COMMANDS=false
COMMANDS_FILE=""
LIST_VERSIONS=false
LIST_SKIP_BREW=false
LIST_MODE=false

resolve_script_path() {
    local path="$1"
    if [[ "$path" != /* && "$path" != *"/"* ]]; then
        path="$(command -v "$path" 2>/dev/null || echo "$path")"
    fi
    while [[ -L "$path" ]]; do
        local dir target
        dir="$(cd -P "$(dirname "$path")" && pwd)"
        target="$(readlink "$path")"
        [[ "$target" != /* ]] && target="$dir/$target"
        path="$target"
    done
    echo "$path"
}

SCRIPT_PATH="$(resolve_script_path "${BASH_SOURCE[0]:-$0}")"
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
COMMANDS_FILE="$SCRIPT_DIR/update-all.commands"
source "$SCRIPT_DIR/lib/global-packages.sh"
source "$SCRIPT_DIR/lib/custom-commands.sh"
source "$SCRIPT_DIR/lib/tool-runner.sh"

# Colors
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[0;33m'
readonly BLUE='\033[0;34m'
readonly RED='\033[0;31m'
readonly CYAN='\033[0;36m'
readonly BOLD='\033[1m'
readonly DIM='\033[2m'
readonly NC='\033[0m'

# Cleanup on exit
cleanup() {
    local exit_code=$?
    # Only remove a lock this process actually acquired, and only if it still
    # holds our PID: `list`/`list --help` never acquire a lock, and a forced
    # takeover may have since replaced it with another process's PID.
    if [[ "$LOCK_ACQUIRED" == true && -f "$LOCK_FILE" ]]; then
        if [[ "$(cat "$LOCK_FILE" 2>/dev/null || echo "")" == "$$" ]]; then
            rm -f "$LOCK_FILE"
        fi
    fi
    if [[ -n "${REPORT_DIR:-}" && -d "$REPORT_DIR" ]]; then
        rm -rf "$REPORT_DIR"
    fi
    if [[ $exit_code -ne 0 && $exit_code -ne 130 && "$LIST_MODE" != true ]]; then
        echo -e "\n${RED}Script aborted (exit code: $exit_code)${NC}"
    fi
    exit $exit_code
}
trap cleanup EXIT INT TERM

# Utility functions
command_exists() { command -v "$1" >/dev/null 2>&1; }

show_progress() {
    local current="$1"
    local total="$2"
    local label="$3"
    printf '\n%b%2s/%s%b  %b%s%b\n' "$BLUE" "$current" "$total" "$NC" "$BOLD" "$label" "$NC"
}

log_status() {
    local component="$1"
    local status="$2"
    [[ -d "$REPORT_DIR" ]] || return
    printf '%s\t%s\n' "$component" "$status" >> "$REPORT_DIR/status.log"
}

# Execute command with proper error handling and reporting
safe_execute() {
    local description="$1"
    shift
    if [[ "$DRY_RUN" = true ]]; then
        printf '  %b↳%b  Would execute: %s\n' "$CYAN" "$NC" "$*"
        log_status "$description" "🔍 Dry run"
        return 0
    fi

    [[ "$VERBOSE" = true ]] && printf '  %b↳%b  Executing: %s\n' "$CYAN" "$NC" "$*"

    local output exit_code
    local previous_errexit=0
    [[ $- == *e* ]] && previous_errexit=1

    set +e
    output=$("$@" 2>&1)
    exit_code=$?
    if [[ $previous_errexit -eq 1 ]]; then set -e; else set +e; fi

    if [[ $exit_code -eq 0 ]]; then
        log_status "$description" "✅ Success"
        [[ "$VERBOSE" = true ]] && printf '  %b✓%b  %s completed\n' "$GREEN" "$NC" "$description"
    else
        log_status "$description" "❌ Failed (exit code: $exit_code)"
        printf '  %b✗%b  %s failed (exit code %s)\n' "$RED" "$NC" "$description" "$exit_code"
        local cmd_str="$*"
        printf '     %bCommand:%b %s\n' "$DIM" "$NC" "$cmd_str"
        if [[ -n "$output" ]]; then
            while IFS= read -r line; do
                printf '     %s\n' "$line"
            done <<< "$output"
        fi
    fi
    return $exit_code
}

acquire_lock() {
    if [[ -f "$LOCK_FILE" ]]; then
        local lock_pid
        lock_pid=$(cat "$LOCK_FILE" 2>/dev/null || echo "")
        if [[ -n "$lock_pid" ]] && kill -0 "$lock_pid" 2>/dev/null; then
            if [[ "$FORCE_RUN" = true ]]; then
                echo -e "${YELLOW}Warning: Forcibly removing existing lock file (PID: $lock_pid)${NC}"
                rm -f "$LOCK_FILE"
            else
                echo -e "${RED}Error: Another instance is already running (PID: $lock_pid)${NC}"
                exit 1
            fi
        else
            rm -f "$LOCK_FILE"
        fi
    fi
    echo "$$" > "$LOCK_FILE"
    LOCK_ACQUIRED=true
}

# --- UPDATE FUNCTIONS ---

update_homebrew() {
    safe_execute "Homebrew update" brew update
    safe_execute "Homebrew upgrade" brew upgrade
    safe_execute "Homebrew cleanup" brew cleanup
}

update_mise_tools() {
    safe_execute "mise tool upgrades" mise upgrade --yes
    safe_execute "mise reshim" mise reshim
}

run_custom_command() {
    local label="$1"
    local line="$2"
    safe_execute "$label" bash -lc "$line"
}

update_custom_commands() {
    declare -A result=()
    custom_commands_run result "$COMMANDS_FILE" "$REPORT_DIR" "$DRY_RUN" log_status run_custom_command
}

update_global_packages() {
    declare -A result=()
    global_packages_run result "$REPORT_DIR" "$DRY_RUN" log_status
}


check_macos_updates() {
    if [[ "$DRY_RUN" = true ]]; then
        log_status "macOS Updates" "🔍 Dry run"
        return
    fi
    local updates_output
    if updates_output=$(softwareupdate -l 2>&1); then
        if echo "$updates_output" | grep -q "No new software available"; then
            log_status "macOS Updates" "✅ Up to date"
        else
            echo -e "${YELLOW}Available macOS updates:${NC}\n$updates_output"
            log_status "macOS Updates" "⚠️ Updates available"
        fi
    else
        log_status "macOS Updates" "❌ Check failed"
    fi
}

# --- Tool runner configuration ---

homebrew_tool_enabled() { command_exists brew; }
homebrew_tool_components() {
    printf '%s\n' "Homebrew update" "Homebrew upgrade" "Homebrew cleanup"
}

macos_tool_enabled() { command_exists softwareupdate; }
macos_tool_components() { printf '%s\n' "macOS Updates"; }

mise_tool_enabled() { command_exists mise; }
mise_tool_components() { printf '%s\n' "mise tool upgrades" "mise reshim"; }

global_packages_tool_enabled() { return 0; }
global_packages_tool_components() {
    printf '%s\n' "pipx packages" "npm global packages" "pnpm global packages" "bun global packages" "uv tools"
}

custom_commands_tool_enabled() {
    custom_commands_should_run "$SKIP_COMMANDS" "$COMMANDS_FILE"
}
custom_commands_tool_disabled() {
    custom_commands_handle_disabled "$SKIP_COMMANDS" log_status "$COMMANDS_FILE"
}
custom_commands_tool_components() { printf '%s\n' "custom commands"; }

configure_tool_runner() {
    tool_runner_reset
    tool_runner_define_phase "phase1" "parallel" "Waiting for system and runtime updates…"
    tool_runner_define_phase "phase2" "parallel" "Waiting for package updates…"
    tool_runner_define_phase "post" "serial"

    tool_runner_register "homebrew" "phase1" "Updating Homebrew" \
        homebrew_tool_enabled update_homebrew homebrew_tool_components
    tool_runner_register "macos" "phase1" "Checking macOS System Updates" \
        macos_tool_enabled check_macos_updates macos_tool_components
    tool_runner_register "mise" "phase1" "Updating mise tools (Runtimes)" \
        mise_tool_enabled update_mise_tools mise_tool_components
    tool_runner_register "global_packages" "phase2" "Updating global packages (Bun, npm, pnpm, Pipx, uv)" \
        global_packages_tool_enabled update_global_packages global_packages_tool_components
    tool_runner_register "custom_commands" "post" "Running custom commands" \
        custom_commands_tool_enabled update_custom_commands custom_commands_tool_components custom_commands_tool_disabled
}

# --- SHARED ENVIRONMENT ---

setup_environment() {
    cd "$HOME"
    export PNPM_HOME="${PNPM_HOME:-$HOME/Library/pnpm}"
    export PATH="$HOME/.bun/bin:$HOME/.local/share/mise/shims:$PATH:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/sbin"
    if command_exists mise; then eval "$(mise activate bash)"; fi
    export PATH="$PNPM_HOME/bin:$PNPM_HOME:$PATH"
}

# --- LIST COMMAND ---

# Join non-empty stdin lines with ", ".
list_join_commas() {
    awk 'NF{printf "%s%s", sep, $0; sep=", "} END{if(sep!="")print ""}'
}

# Print a section header on its own line: bold "<label>:".
list_section_header() {
    printf '%b%s:%b\n' "$BOLD" "$1" "$NC"
}

# Print a dim bullet body line: "  ·  <text>".
list_section_body() {
    printf '  %b·  %s%b\n' "$DIM" "$1" "$NC"
}

# Print a manager section as two lines (header + dim bullet body).
# Empty items render as "none".
list_emit() {
    local label="$1" items="$2"
    list_section_header "$label"
    if [[ -z "$items" ]]; then
        list_section_body "none"
    else
        list_section_body "$items"
    fi
}

# Render an associative array (name=version) as a manager line.
list_emit_assoc() {
    local label="$1" aname="$2"
    local -n _items="$aname"
    local joined
    if [[ "$LIST_VERSIONS" == true ]]; then
        joined="$(for k in "${!_items[@]}"; do printf '%s %s\n' "$k" "${_items[$k]}"; done | sort -u | list_join_commas)"
    else
        joined="$(printf '%s\n' "${!_items[@]}" | sort -u | list_join_commas)"
    fi
    list_emit "$label" "$joined"
}

list_homebrew_line() {
    command_exists brew || { list_emit "Homebrew" "not installed"; return 0; }
    local rc=0 formula_out cask_out
    if [[ "$LIST_VERSIONS" == true ]]; then
        formula_out="$(brew list --versions --formula 2>/dev/null)" || rc=1
        cask_out="$(brew list --versions --cask 2>/dev/null)" || rc=1
    else
        formula_out="$(brew list --formula 2>/dev/null)" || rc=1
        cask_out="$(brew list --cask 2>/dev/null)" || rc=1
    fi
    if [[ $rc -ne 0 ]]; then
        list_emit "Homebrew" "failed"
        return 1
    fi
    local items
    items="$(printf '%s\n%s\n' "$formula_out" "$cask_out" | awk 'NF' | sort -u | list_join_commas)"
    list_emit "Homebrew" "$items"
    return 0
}

list_macos_line() {
    if command_exists softwareupdate; then
        list_emit "macOS Software Update" "available"
    else
        list_emit "macOS Software Update" "not installed"
    fi
    return 0
}

list_mise_line() {
    command_exists mise || { list_emit "mise" "not installed"; return 0; }
    local out rc=0
    out="$(mise ls --installed --no-header 2>/dev/null)" || rc=1
    if [[ $rc -ne 0 ]]; then
        list_emit "mise" "failed"
        return 1
    fi
    local items
    if [[ "$LIST_VERSIONS" == true ]]; then
        items="$(printf '%s\n' "$out" | awk 'NF>=2 && $1!~/^(Plugin|Tool|Name|Package)$/ {print $1, $2}' | sort -u | list_join_commas)"
    else
        items="$(printf '%s\n' "$out" | awk 'NF>=2 && $1!~/^(Plugin|Tool|Name|Package)$/ {print $1}' | sort -u | list_join_commas)"
    fi
    list_emit "mise" "$items"
    return 0
}

list_pipx_line() {
    command_exists pipx || { list_emit "pipx" "not installed"; return 0; }
    local out rc=0
    out="$(pipx list --short 2>/dev/null)" || rc=1
    if [[ $rc -ne 0 ]]; then
        list_emit "pipx" "failed"
        return 1
    fi
    local -A versions=()
    local name ver
    while IFS=$'\t' read -r name ver; do
        [[ -n "$name" ]] && versions["$name"]="$ver"
    done < <(printf '%s\n' "$out" | awk 'NF>=2 && $2~/^[0-9]/ {printf "%s\t%s\n", $1, $2}')
    list_emit_assoc "pipx" versions
    return 0
}

list_npm_line() {
    command_exists npm || { list_emit "npm" "not installed"; return 0; }
    local out rc=0
    out="$(npm list -g --depth=0 2>/dev/null)" || rc=1
    if [[ $rc -ne 0 ]]; then
        list_emit "npm" "failed"
        return 1
    fi
    local -A versions=()
    parse_npm_tree versions <<< "$out"
    list_emit_assoc "npm" versions
    return 0
}

list_pnpm_line() {
    command_exists pnpm || { list_emit "pnpm" "not installed"; return 0; }
    local out rc=0
    out="$(pnpm list -g --depth=0 2>/dev/null)" || rc=1
    if [[ $rc -ne 0 ]]; then
        list_emit "pnpm" "failed"
        return 1
    fi
    local -A versions=()
    parse_pnpm_tree versions <<< "$out"
    list_emit_assoc "pnpm" versions
    return 0
}

list_bun_line() {
    command_exists bun || { list_emit "Bun" "not installed"; return 0; }
    local workdir errfile out err rc=0
    # Mirror the Bun updater: list globals from a fresh temp directory so a
    # local lockfile/project context cannot break or pollute the inventory.
    workdir="$(mktemp -d "/tmp/update-all-list-bun.XXXXXX")"
    errfile="$(mktemp "/tmp/update-all-list-bun.err.XXXXXX")"
    out="$(cd "$workdir" && bun pm ls -g 2>"$errfile")" || rc=$?
    err="$(<"$errfile")"
    rm -rf "$workdir" "$errfile"
    if [[ $rc -ne 0 ]]; then
        # Bun's empty-global state emits "Lockfile not found" and exits 1; treat
        # that as an empty inventory rather than a collector failure.
        if [[ "$err" == *"Lockfile not found"* ]]; then
            list_emit "Bun" "none"
            return 0
        fi
        list_emit "Bun" "failed"
        return 1
    fi
    local -A versions=()
    parse_bun_tree versions <<< "$out"
    list_emit_assoc "Bun" versions
    return 0
}

list_uv_line() {
    command_exists uv || { list_emit "uv" "not installed"; return 0; }
    local out rc=0
    out="$(uv tool list 2>/dev/null)" || rc=1
    if [[ $rc -ne 0 ]]; then
        list_emit "uv" "failed"
        return 1
    fi
    local items
    if [[ "$LIST_VERSIONS" == true ]]; then
        items="$(printf '%s\n' "$out" | awk 'NF>=2 && $1!~/^-/ && $2~/^v?[0-9]/ {print $1, $2}' | sort -u | list_join_commas)"
    else
        items="$(printf '%s\n' "$out" | awk 'NF>=2 && $1!~/^-/ && $2~/^v?[0-9]/ {print $1}' | sort -u | list_join_commas)"
    fi
    list_emit "uv" "$items"
    return 0
}

list_custom_commands_lines() {
    if [[ "$SKIP_COMMANDS" == true ]]; then
        list_emit "custom commands" "skipped"
        return 0
    fi
    if [[ ! -f "$COMMANDS_FILE" ]] || ! custom_commands_has_entries "$COMMANDS_FILE"; then
        list_emit "custom commands" "none"
        return 0
    fi
    list_section_header "custom commands"
    local line trimmed
    while IFS= read -r line || [[ -n "$line" ]]; do
        trimmed="$(_custom_commands_trim "$line")"
        [[ -z "$trimmed" || "$trimmed" == \#* ]] && continue
        list_section_body "$trimmed"
    done < "$COMMANDS_FILE"
    return 0
}

run_list() {
    local failures=0
    if [[ "$LIST_SKIP_BREW" != true ]]; then
        list_homebrew_line || failures=1
    fi
    list_macos_line
    list_mise_line || failures=1
    list_pipx_line || failures=1
    list_npm_line || failures=1
    list_pnpm_line || failures=1
    list_bun_line || failures=1
    list_uv_line || failures=1
    list_custom_commands_lines
    return $failures
}

run_list_dispatch() {
    LIST_MODE=true
    LIST_VERSIONS=false
    LIST_SKIP_BREW=false
    while [[ $# -gt 0 ]]; do
        case $1 in
            --versions) LIST_VERSIONS=true ;;
            --skip-brew) LIST_SKIP_BREW=true ;;
            --commands-file)
                shift
                [[ $# -gt 0 ]] || { echo "--commands-file requires a path" >&2; exit 1; }
                COMMANDS_FILE="$1"
                ;;
            --skip-commands) SKIP_COMMANDS=true ;;
            --help|-h)
                cat <<EOF
Usage: $SCRIPT_NAME list [options]

List installed items for each package manager in update order.

Options:
  --versions           Show versions alongside item names.
  --skip-brew          Omit Homebrew entirely.
  --commands-file PATH Use a custom commands file (default: $SCRIPT_DIR/update-all.commands)
  --skip-commands      Do not list custom commands.
  --help, -h           Show this help
EOF
                exit 0
                ;;
            *) echo "Unknown option: $1" >&2; exit 1 ;;
        esac
        shift
    done
    setup_environment
    run_list
}

# --- MAIN EXECUTION ---

main() {
    set +e

    if [[ "${1:-}" == "list" ]]; then
        shift
        run_list_dispatch "$@"
        return $?
    fi

    while [[ $# -gt 0 ]]; do
        case $1 in
            --dry-run) DRY_RUN=true ;;
            --verbose) VERBOSE=true ;;
            --force) FORCE_RUN=true ;;
            --commands-file)
                shift
                [[ $# -gt 0 ]] || { echo "--commands-file requires a path" >&2; exit 1; }
                COMMANDS_FILE="$1"
                ;;
            --skip-commands) SKIP_COMMANDS=true ;;
            --help|-h)
                cat <<EOF
Usage: $SCRIPT_NAME [options]
       $SCRIPT_NAME list [options]

Options:
  --dry-run            Print commands without executing
  --verbose            Print commands as they run
  --force              Force run even if lock exists
  --commands-file PATH Use a custom commands file (default: $SCRIPT_DIR/update-all.commands)
  --skip-commands      Disable running custom commands
  --help, -h           Show this help

Subcommands:
  list                 List installed items without updating (see 'list --help')
EOF
                exit 0
                ;;
            *) echo "Unknown option: $1" >&2; exit 1 ;;
        esac
        shift
    done

    printf '\n%bUpdate all%b\n' "$BOLD" "$NC"
    if [[ "$DRY_RUN" = true ]]; then
        printf '%bSystem and developer tools · dry run%b\n' "$DIM" "$NC"
    else
        printf '%bSystem and developer tools%b\n' "$DIM" "$NC"
    fi

    # 1. SETUP PHASE
    acquire_lock
    REPORT_DIR="$(mktemp -d "/tmp/${SCRIPT_NAME}_reports.XXXXXX")"
    if [[ ! -d "$REPORT_DIR" ]]; then
        echo "Failed to create report directory. Exiting." >&2
        exit 1
    fi
    setup_environment

    global_packages_snapshot "$REPORT_DIR"
    configure_tool_runner
    tool_runner_execute "$REPORT_DIR" show_progress
}

[[ "${DEBUG:-}" == "true" ]] && set -x
main "$@"
